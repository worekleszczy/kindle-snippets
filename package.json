{
  "name": "kindle-sync",
  "version": "0.1.0",
  "description": "Kindle snippets sync CLI",
  "type": "module",
  "scripts": {
    "build": "bun build --compile src/cli.ts --outfile kindle-sync",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "verify": "bun run typecheck && bun run check && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
